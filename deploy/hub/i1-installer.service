[Unit]
Description=i1.is universal installer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=i1-installer
Group=i1-installer
WorkingDirectory=/var/lib/i1-is
Environment=HOST=127.0.0.1
Environment=PORT=8431
Environment=PUBLIC_URL=https://i1.is
Environment=TLS_ENABLED=false
Environment=ENABLE_TELEMETRY=false
Environment=RUST_LOG=i1_is=info
Environment=FINGERPRINT_DB_PATH=/var/lib/i1-is/fingerprints.json
Environment=SYSTEM_PROFILE_DB_PATH=/var/lib/i1-is/system_profiles.json
ExecStart=/usr/local/lib/i1-installer/current/i1-is
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/i1-is
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
MemoryMax=1G
TasksMax=128

[Install]
WantedBy=multi-user.target
